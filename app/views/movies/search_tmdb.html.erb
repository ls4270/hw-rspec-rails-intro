<h2>Search in TMDb</h2>

<% flash.each do |key, value| %>
  <div class="alert alert-<%= key %>">
    <%= value %>
  </div>
<% end %>

<div class="search-container">
  <%= form_tag search_tmdb_path, method: :get, id: 'tmdb_form' do %>
    <div class="mb-3">
      <%= label_tag :title, 'Movie Name' %>
      <%= text_field_tag :title, params[:title],
          class: 'form-control',
          id: 'movie_title_field',
          placeholder: 'Manhunter' %>
    </div>

    <div class="mb-3">
      <%= label_tag :release_year, 'Release Year' %>
      <%= text_field_tag :release_year, params[:release_year],
          class: 'form-control',
          id: 'movie_year_field',
          placeholder: '1986' %>
    </div>

    <div class="form-check">
      <%= radio_button_tag :language, 'en',
          params[:language] == 'en',
          class: 'form-check-input' %>
      <%= label_tag 'language_en', 'English Only' %>
    </div>

    <div class="form-check">
      <%= radio_button_tag :language, 'all',
          params[:language] != 'en',
          class: 'form-check-input' %>
      <%= label_tag 'language_all', 'All Languages' %>
    </div>

    <%= submit_tag 'Search',
        id: 'tmdb_submit',
        class: 'btn btn-warning' %>
  <% end %>
</div>

<%= link_to 'Back to Home Page', movies_path,
    class: 'btn btn-secondary mt-3' %>

<% if @movies.present? %>
  <h3>Search Results</h3>

  <table id="search_movies" class="table table-striped">
    <thead>
      <tr>
        <th>Movie Title</th>
        <th>Rating</th>
        <th>Release Date</th>
        <th>Description</th>
        <th>Add Movie</th>
      </tr>
    </thead>

    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date %></td>
          <td><%= movie.description %></td>
          <td>
            <%= form_tag add_movie_path, method: :post do %>
              <%= hidden_field_tag 'movie[title]', movie.title %>
              <%= hidden_field_tag 'movie[rating]', movie.rating %>
              <%= hidden_field_tag 'movie[release_date]',
                  movie.release_date %>
              <%= hidden_field_tag 'movie[description]',
                  movie.description %>

              <%= submit_tag 'Add Movie',
                  class: 'btn btn-success' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
